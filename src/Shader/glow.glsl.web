#version 100

precision mediump float;

// credit: https://github.com/kiwipxl/GLSL-shaders/blob/master/glow.glsl

// Input vertex attributes (from vertex shader)
varying vec2 fragTexCoord;
varying vec4 fragColor;

// Input uniform values
uniform sampler2D texture0;
uniform vec4 colDiffuse;
uniform vec2 iResolution;

// hard coded vars: 
const float glow_size = .5;
const float glow_intensity = 1.;
const float glow_threshold = .5;

vec2 norm(ivec2 coord) {
    vec2 newCoord = vec2(coord);
    return newCoord/iResolution;
}

void main() {
    gl_FragColor = texture2D(texture0, fragTexCoord);
    if (gl_FragColor .a <= glow_threshold) {
	
        float uv_x = fragTexCoord.x * iResolution.x;
        float uv_y = fragTexCoord.y * iResolution.y;

        float sum = 0.0;
        for (int n = 0; n < 9; ++n) {
            uv_y = (fragTexCoord.y * iResolution.y) + (glow_size * float(float(n) - 4.5));
            float h_sum = 0.0;
            h_sum += texture2D(texture0, norm(ivec2(uv_x - (4.0 * glow_size), uv_y))).a;
            h_sum += texture2D(texture0, norm(ivec2(uv_x - (3.0 * glow_size), uv_y))).a;
            h_sum += texture2D(texture0, norm(ivec2(uv_x - (2.0 * glow_size), uv_y))).a;
            h_sum += texture2D(texture0, norm(ivec2(uv_x - glow_size, uv_y))).a;
            h_sum += texture2D(texture0, norm(ivec2(uv_x, uv_y))).a;
            h_sum += texture2D(texture0, norm(ivec2(uv_x + glow_size, uv_y))).a;
            h_sum += texture2D(texture0, norm(ivec2(uv_x + (2.0 * glow_size), uv_y))).a;
            h_sum += texture2D(texture0, norm(ivec2(uv_x + (3.0 * glow_size), uv_y))).a;
            h_sum += texture2D(texture0, norm(ivec2(uv_x + (4.0 * glow_size), uv_y))).a;
            sum += h_sum / 9.0;
        }

        gl_FragColor = vec4(vec3(fragColor.r, fragColor.g, fragColor.b), (sum / 9.0) * glow_intensity);
    }
}

