    vec4 sampleCol = texture2D(texture0, fragTexCoord);
    // this is crazy -- apparently sampleCol.r is more than 1 even though it *should* be normalized
    // int flags = int(sampleCol.r * 256.);
    // if ((flags & OUTLINE_EFFECT) != 0) {
    // if (flags > 5000) {
    // if (sampleCol.r > 256.) {
    //     gl_FragColor = vec4(1.);
    // }

    // default state
    gl_FragColor = vec4(0.);
    // gl_FragColor = bloom();

    // for now, I'll just treat each channel as a binary flag
    // r == bloom 
    // g == glow
    // b == occlusion (not used in this shader)
    gl_FragColor += bloom();
    gl_FragColor += glow();
}



